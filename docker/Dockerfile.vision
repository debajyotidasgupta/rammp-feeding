# kinova_vision (ros2_kortex_vision) layered onto the RAMMP arm image.
#
# Kinova streams depth over RTSP as a raw 16-bit format that ffmpeg/VLC cannot
# decode -- ffprobe reports codec_type=data. kinova_vision is the GStreamer
# pipeline that parses it and republishes it as sensor_msgs/Image, so this is
# the only supported way to actually see depth.
#
#   docker build -f docker/Dockerfile.vision -t rammp/kortex-vision:humble .
FROM kinova-gen3-ros2:kortex

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-tools \
      ros-humble-camera-calibration-parsers \
      ros-humble-camera-info-manager \
      ros-humble-cv-bridge \
      ros-humble-image-transport \
      ros-humble-rclcpp-components \
      ros-humble-tf2 ros-humble-tf2-ros \
      python3-opencv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws
# Default branch is `ros2`, not main.
RUN git clone -b ros2 --depth 1 \
      https://github.com/Kinovarobotics/ros2_kortex_vision.git \
      src/ros2_kortex_vision

# --- upstream bugfix ----------------------------------------------------------
# Vision::loadCameraInfo() runs on EVERY stream (re)start but calls
# declare_parameter() unconditionally. The Kinova RTSP feed pauses and
# reconnects on its own ("Could not get frame" -> PAUSED -> started), and on
# that second call rclcpp throws ParameterAlreadyDeclaredException, which
# aborts the node (SIGABRT). Guard both declares so reconnects are survivable.
RUN f=src/ros2_kortex_vision/src/vision.cpp && \
    sed -i 's|^\( *\)node_->declare_parameter<std::string>(CAMERA_INFO_URL_USER_PARAM);|\1if (!node_->has_parameter(CAMERA_INFO_URL_USER_PARAM))\n\1  node_->declare_parameter<std::string>(CAMERA_INFO_URL_USER_PARAM);|' $f && \
    sed -i 's|^\( *\)node_->declare_parameter<std::string>(CAMERA_INFO_URL_DEFAULT_PARAM);|\1if (!node_->has_parameter(CAMERA_INFO_URL_DEFAULT_PARAM))\n\1  node_->declare_parameter<std::string>(CAMERA_INFO_URL_DEFAULT_PARAM);|' $f && \
    grep -n "has_parameter(CAMERA_INFO" $f

# Build only the new package; the arm workspace is already built in the base.
RUN source /opt/ros/humble/setup.bash && \
    source /ros2_ws/install/setup.bash && \
    colcon build --symlink-install --packages-select kinova_vision \
      --cmake-args -DCMAKE_BUILD_TYPE=Release

CMD ["bash"]

# Depth colorizer used for live viewing / recording. Baked in so a container
# restart cannot lose it (it previously lived in /tmp and vanished on recreate).
COPY depth_stream.py /opt/depth_stream.py
