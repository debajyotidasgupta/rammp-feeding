# The driver container: what the arm scripts (kinova/, via `make` INARM) need and nothing else.
# Python 3.10 (Ubuntu 22.04), numpy as on the 2026-09 deployment (the golden arm trace is float-exact against it),
# and the Kortex Python API -- 2.8.0, the last line that speaks TCP to this firmware (requirements.txt says why).
#
#   make driver-image     # -> deployment.images.driver
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install "numpy==2.2.6" "pyyaml==6.0.2" "protobuf==3.20.0" \
      "kortex_api @ https://artifactory.kinovaapps.com/artifactory/generic-public/kortex/API/2.8.0/kortex_api-2.8.0.post5-py3-none-any.whl" \
    && python3 -c "import kortex_api, numpy; print('kortex_api ok, numpy', numpy.__version__)"

WORKDIR /work
CMD ["sleep", "infinity"]
