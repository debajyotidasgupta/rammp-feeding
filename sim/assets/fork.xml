<mujoco model="fork">
  <!-- Fork held rigidly in the 2F-85. The gripper never opens during a meal
       (see docs/feeding-architecture.md §5), so the grasp is modelled as a weld
       rather than simulating the fingers. The TCP is the TINE TIPS, not the
       gripper face - that distinction is the whole point of adding this. -->
  <default>
    <default class="fork">
      <geom type="capsule" rgba="0.85 0.85 0.88 1" mass="0.02"
            friction="0.9 0.01 0.001" contype="1" conaffinity="1"/>
    </default>
  </default>
  <worldbody>
    <body name="fork_root">
      <!-- handle, running out along -z from the tool flange -->
      <geom class="fork" name="handle" size="0.008" fromto="0 0 0  0 0 0.085"/>
      <!-- neck -->
      <geom class="fork" name="neck" size="0.005" fromto="0 0 0.085  0 0 0.115"/>
      <!-- four tines, 30 mm long, 8 mm apart -->
      <geom class="fork" name="tine0" size="0.0016" fromto="-0.012 0 0.115  -0.012 0 0.145"/>
      <geom class="fork" name="tine1" size="0.0016" fromto="-0.004 0 0.115  -0.004 0 0.145"/>
      <geom class="fork" name="tine2" size="0.0016" fromto=" 0.004 0 0.115   0.004 0 0.145"/>
      <geom class="fork" name="tine3" size="0.0016" fromto=" 0.012 0 0.115   0.012 0 0.145"/>
      <!-- THE control frame: tip of the tines -->
      <site name="tcp" pos="0 0 0.145" size="0.004" rgba="1 0.9 0.1 1"/>
      <!-- wrist camera, approximating the L53 module pose on the bracelet -->
      <camera name="wrist" pos="0 -0.06 0.02" euler="1.2 0 0" fovy="58"/>
    </body>
  </worldbody>
</mujoco>
