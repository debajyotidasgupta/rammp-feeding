# ROS 2 Humble + Kinova Kortex driver for the Gen3 7-DoF / Robotiq 2F-85.
#
# NOTE: pinned to linux/amd64 on purpose. Kinova publishes the kortex_driver
# and kortex_api Debians for amd64 only -- there is no arm64 build -- so on
# Apple Silicon this image runs under emulation. Fine for MoveIt planning and
# high-level control; see README for the native-arm64 source build if you need
# the 1 kHz low-level loop.
FROM --platform=linux/amd64 ros:humble-ros-base

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-kortex-driver \
      ros-humble-kortex-bringup \
      ros-humble-kortex-description \
      ros-humble-kinova-gen3-7dof-robotiq-2f-85-moveit-config \
      ros-humble-moveit \
      ros-humble-ros2-control \
      ros-humble-ros2-controllers \
      ros-humble-robot-state-publisher \
      ros-humble-xacro \
      ros-humble-rviz2 \
      python3-colcon-common-extensions \
      iputils-ping iproute2 net-tools \
    && rm -rf /var/lib/apt/lists/*

# Cyclone DDS is better behaved than the default Fast-DDS inside a NAT'd
# container, where multicast discovery to the host is unreliable.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

ENV KINOVA_IP=192.168.2.67
WORKDIR /ws

RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
